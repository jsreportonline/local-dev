store_provider=mongodb
extensions_mongodbStore_uri=mongodb://mongodb:27017/multitenant-local
db_rootDatabaseName=multitenant-root-local
db_databaseName=multitenant-local
skipSchedules=true
createIndexes=true
NODE_ENV=development
aws_accessKeyId=fake
aws_secretAccessKey=fake
loggly_level=info
loggly_subdomain=jsreport
debug=jsreport

s3_bucket=jsreportonline-test

salesUrl=http://sales:1500
admin=joadmin
encryption_enabled=false
extensions_authentication_cookieSession_secret=aaaaaaaaaaaaaaaaaaaaaaaa
extensions_authentication_admin_username=admin
extensions_authentication_admin_password=password
extensions_assets_allowAssetsLinkedToFiles=false
extensions_scheduling_minScheduleInterval=300000
extensions_express_inputRequestLimit=50mb
office_preview_showWarning=false
profiler_cleanupInterval=10m
profiler_fullModeDuration=30m
extensions_electronPdf_strategy=electron-ipc
extensions_phantomPdf_strategy=phantom-server

extensions_dockerWorkers_container_customEnv=workerInputRequestLimit=50mb
extensions_dockerWorkers_container_image=joworker
extensions_dockerWorkers_container_memorySwap=5620m
extensions_dockerWorkers_container_memory=5620m
extensions_dockerWorkers_container_cpus=0.9

